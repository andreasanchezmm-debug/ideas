{
  "name": "donut-alicante",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "admin:password": "node scripts/password.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write app components lib tests scripts docs *.ts *.json *.md",
    "format:check": "prettier --check app components lib tests scripts docs *.ts *.json *.md",
    "demo:build": "vite build",
    "demo:preview": "vite preview",
    "demo:test": "playwright test --config playwright.demo.config.ts",
    "demo:publish": "node scripts/publish-demo.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.7"
  },
  "overrides": {
    "postcss": "^8.5.31",
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  }
}
